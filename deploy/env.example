# Copy to deploy/.env and fill in. Keep .env private (chmod 600).

# The shared secret for TURN credentials. MUST be the same as
# static-auth-secret in /etc/turnserver.conf. Generate one with:
#   openssl rand -hex 32
WILDJOKER_TURN_SECRET=CHANGE_ME

# TURN servers handed to browsers (comma-separated). Replace the domain if
# coturn runs under another name.
WILDJOKER_TURN_URLS=turn:wildjoker.0s.is:3478?transport=udp,turn:wildjoker.0s.is:3478?transport=tcp,turns:wildjoker.0s.is:5349?transport=tcp

# STUN servers (comma-separated): our own coturn first, Google as a fallback.
WILDJOKER_STUN_URLS=stun:wildjoker.0s.is:3478,stun:stun.l.google.com:19302

# How long TURN credentials are valid, in seconds (browsers refresh them).
WILDJOKER_TURN_TTL=43200

# Host port the container listens on (127.0.0.1 only); Caddy proxies to it.
WILDJOKER_PORT=8100
