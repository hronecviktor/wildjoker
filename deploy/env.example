# Copy to .env next to docker-compose.yml and fill in. Keep it private
# (chmod 600).

# The image to run (pushed to Docker Hub with deploy/publish.sh).
WILDJOKER_IMAGE=hronecviktor/wildjoker:latest

# The shared secret for TURN credentials. MUST be the same as
# static-auth-secret in /etc/turnserver.conf. Generate one with:
#   openssl rand -hex 32
WILDJOKER_TURN_SECRET=CHANGE_ME

# TURN servers handed to browsers (comma-separated). coturn runs under
# zolik.0s.is (players can use the game at cards.0s.is too).
WILDJOKER_TURN_URLS=turn:zolik.0s.is:3478?transport=udp,turn:zolik.0s.is:3478?transport=tcp,turns:zolik.0s.is:5349?transport=tcp

# STUN servers (comma-separated): our own coturn first, Google as a fallback.
WILDJOKER_STUN_URLS=stun:zolik.0s.is:3478,stun:stun.l.google.com:19302

# How long TURN credentials are valid, in seconds (browsers refresh them).
WILDJOKER_TURN_TTL=43200

# Host port the container listens on (127.0.0.1 only); Caddy proxies to it.
WILDJOKER_PORT=8100
