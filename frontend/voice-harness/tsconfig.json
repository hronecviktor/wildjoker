{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "vitest": [
        "./node_modules/vitest/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "../src/lib/voice/**/*.ts",
    "src/**/*.ts",
    "node_modules/svelte/types/index.d.ts"
  ]
}
